<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Thiết lập trang mặc định khi vào cổng 5555 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Khai báo MIME Type chuẩn cho JSON và Tắt Cache để luôn nhận ảnh & data mới nhất -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- Bảo mật và Header chuẩn (Chống cache để đảm bảo nghiệm thu luôn thấy thay đổi mới nhất) -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma" value="no-cache" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
