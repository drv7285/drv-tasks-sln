<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Thiết lập trang mặc định khi vào cổng 5555 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Khai báo MIME Type chuẩn cho JSON (tránh lỗi IIS chặn file .json) -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
    </staticContent>

    <!-- Bảo mật và Header chuẩn -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
